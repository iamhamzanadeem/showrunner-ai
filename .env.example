# ==============================================================================
# SHOWRUNNER AI - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and adjust variables as needed for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE PROVIDER SELECTION
# ------------------------------------------------------------------------------
# Active provider bundle: "auto" | "mock" | "google"
# - auto: defaults to "google" if GEMINI_API_KEY or GOOGLE_CLOUD_PROJECT is set,
#         otherwise falls back to "mock"
# - mock: fast, deterministic, offline mock generator (Pillow + FFmpeg lavfi)
# - google: live Google GenAI API suite
SHOWRUNNER_PROVIDER=auto

# ------------------------------------------------------------------------------
# 2. GOOGLE CREDENTIALS & VERTEX AI CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Google AI Studio API Key (simpler for local developer testing)
# GEMINI_API_KEY=AIzaSy...

# Option B: Google Cloud Vertex AI (preferred for production / Cloud Run with ADC)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_LOCATION=global
# VERTEX_LOCATION_MEDIA=us-central1

# Optional: Cloud Storage bucket URI for Vertex Veo video outputs (gs://my-bucket/outputs/)
# SR_GCS_OUTPUT_URI=

# ------------------------------------------------------------------------------
# 3. HYBRID MODE: PER-MODALITY PROVIDER OVERRIDES
# ------------------------------------------------------------------------------
# Override individual modality providers with "mock" or "google".
# For example, use real Gemini planner & critic while using mock video to save Veo quota:
# SR_PROVIDER_PLANNER=google
# SR_PROVIDER_CRITIC=google
# SR_PROVIDER_IMAGE=mock
# SR_PROVIDER_VIDEO=mock
# SR_PROVIDER_TTS=mock
# SR_PROVIDER_MUSIC=mock
SR_PROVIDER_PLANNER=
SR_PROVIDER_IMAGE=
SR_PROVIDER_VIDEO=
SR_PROVIDER_CRITIC=
SR_PROVIDER_TTS=
SR_PROVIDER_MUSIC=

# ------------------------------------------------------------------------------
# 4. GOOGLE GENAI MODEL IDENTIFIERS & VOICE CONFIGURATION
# ------------------------------------------------------------------------------
# Cinematic Director Planner (Gemini text & structured JSON reasoning)
SR_MODEL_PLANNER=gemini-3.8-flash

# Multimodal Quality Critic (Gemini multimodal video inspector)
SR_MODEL_CRITIC=gemini-3.8-flash

# Keyframe & Reference Sheet Generator (Nano Banana 2 via generate_content)
SR_MODEL_IMAGE=gemini-3.1-flash-image

# Video Clip Synthesis (Veo 3.1 Fast image-to-video, 4/6/8s clips)
# Vertex AI GA ID; with GEMINI_API_KEY the provider maps it to veo-3.1-fast-generate-preview.
SR_MODEL_VIDEO=veo-3.1-fast-generate-001

# Text-to-Speech Engine (Interactions API)
SR_MODEL_TTS=gemini-3.8-flash-tts
# Available TTS Voices: Kore, Puck, Charon, Aoede, Sulafat, Gacrux
SR_TTS_VOICE=Kore

# Soundtrack & Score Synthesis (Lyria via Interactions API)
# Uses lyria-3-clip-preview for <= 30s clips; automatically uses lyria-3.5 for longer tracks
SR_MODEL_MUSIC=lyria-3-clip-preview

# ------------------------------------------------------------------------------
# 5. VIDEO GENERATION (VEO) & CRITIC TUNING
# ------------------------------------------------------------------------------
# Resolution: "720p" | "1080p"
SR_VIDEO_RESOLUTION=720p

# Aspect Ratio: "16:9" | "9:16" | "1:1"
SR_ASPECT=16:9

# Maximum seconds to wait for Veo video generation operations
SR_VEO_TIMEOUT_S=600

# Whether to attach reference image assets into Veo calls (requires 8s duration)
SR_VEO_USE_REFERENCES=false

# Veo native audio (Vertex only). Clip audio is replaced by VO + music at assembly,
# so leave false to save ~20% ($0.08/s vs $0.10/s at 720p Fast).
SR_VEO_GENERATE_AUDIO=false

# Critic passing threshold (0.0 to 1.0; score >= 0.70 passes review)
SR_CRITIC_PASS_SCORE=0.7

# ------------------------------------------------------------------------------
# 6. PIPELINE ORCHESTRATION & STORAGE
# ------------------------------------------------------------------------------
# Maximum critic retries per failing shot before accepting best attempt fallback
MAX_RETRIES=2

# Maximum concurrent scenes processed in parallel (shots within a scene remain sequential)
MAX_PARALLEL_SCENES=2

# Artificial delay per step in mock mode (seconds)
MOCK_DELAY_S=0.3

# Local storage path for jobs, assets, and media files
DATA_DIR=./data

# Server listen interface and port
HOST=0.0.0.0
PORT=8080

# ------------------------------------------------------------------------------
# Demo access control (recommended for any public deployment)
# ------------------------------------------------------------------------------
# Shared token required on POST /api/jobs and POST /api/jobs/{id}/chat
# (X-Demo-Token header or ?token=). Leave empty for open local development.
DEMO_TOKEN=
# Max new productions + chat refinements per UTC day (0 = unlimited)
MAX_JOBS_PER_DAY=0
# Comma-separated allowed CORS origins ("*" = any; credentials are never allowed)
CORS_ORIGINS=*
